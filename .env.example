# Browser access key. Generate a long random value and enter it once per device.
VALE_TOKEN=

# Hosted Letta agent
LETTA_URL=https://api.letta.com
LETTA_API_KEY=
LETTA_AGENT_ID=
# Keep false so Letta failures are shown instead of silently changing personas.
LETTA_FALLBACK_TO_CLAUDE=false

# Optional direct Claude fallback and model selector
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Optional integrations
GIPHY_API_KEY=
VALE_HUB_URL=
COMPANONION_URL=
VIDEO_MCP_URL=
GAMES_MCP_URL=

# Set by the Docker image. For non-Docker hosts, point this at persistent storage.
VALE_DATA_DIR=/data
